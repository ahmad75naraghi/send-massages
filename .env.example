# ============================================================
#  .env.example — الگوی پیکربندی سیستم همگام‌سازی
#
#  استفاده:
#     bash setup_env.sh          # از همین الگو .env می‌سازد و مقدارها را
#                                # از تاریخ Git مهاجرت می‌دهد + کلید تصادفی
#     # یا دستی:
#     cp .env.example .env && chmod 600 .env && chown file:file .env
#
#  ⚠️ فایل .env هرگز commit نمی‌شود (.gitignore + .htaccess آن را بسته‌اند).
#  ⚠️ مقدار خالی یعنی «پیکربندی نشده»؛ آن مسیر با پیام صریح شکست می‌خورد.
#
#  قالب: KEY=value   (بدون فاصله اطراف =؛ مقدار فارسی بدون کوتیشن مجاز است)
#  اولویت: متغیر محیطی واقعی (systemd/cron) > این فایل > پیش‌فرض داخل config.php
# ============================================================

# ---------- مسیرها و زمان اجرا ----------
# مسیر استقرار برنامه (بدون / انتهایی)
SYNC_APP_DIR=/home/file/public_html/s
NODE_BIN=/usr/bin/node
# باینری کرومیوم؛ اگر خالی باشد به‌ترتیب /usr/bin/chromium-browser، /usr/bin/chromium و google-chrome آزموده می‌شود
SYNC_CHROMIUM_BIN=/usr/bin/chromium-browser
# باینری PHP مخصوص cron (مثلاً /usr/bin/ea-php81)؛ خالی = تشخیص خودکار
PHP_BIN=

# ---------- دسترسی وب ----------
# کلید داشبورد و اندپوینت‌های AJAX:  sync_manual.php?key=<SECURITY_KEY>
# اگر خالی باشد، setup_env.sh یک مقدار تصادفی ۳۲ نویسه‌ای می‌سازد.
SECURITY_KEY=
# محدودسازی IP داشبورد (اختیاری؛ چند مقدار با کاما). خالی = بدون محدودیت IP
DASHBOARD_ALLOWED_IP=

# ---------- مبدأ: ایتا ----------
EITAA_CHANNEL_ID=shamimeashena
MAX_MESSAGES_LIMIT=7

# ---------- مقصد ۱: بله (Bot API) ----------
BALE_BOT_TOKEN=
BALE_CHANNEL_ID=@testforme
# گیرندهٔ گزارش مدیریتی (chat id عددی مدیر)
BALE_ADMIN_CHAT_ID=

# ---------- مقصد ۲: روبیکا (Bot API) ----------
RUBIKA_BOT_TOKEN=
RUBIKA_CHANNEL_ID=@shamimeashena1
# شناسهٔ یکتا (GUID) کانال روبیکا — فقط برای آزمون تفکیک GUID/username لازم است
RUBIKA_CHAT_ID_GUID=
RUBIKA_CHAT_ID_USER=@shamimeashena1

# ---------- مقصد ۳: سروش‌پلاس (UserBot با Playwright) ----------
SOROUSH_CHANNEL_ID=shamimeashena1
# نام نمایشی کانال در وب‌کلاینت؛ معیار «تأیید باز شدن چت درست» است
SOROUSH_CHANNEL_NAME="شمیم آشنا"
SOROUSH_SCRIPT=/home/file/public_html/s/send_soroush.js
SOROUSH_PROFILE_DIR=/home/file/public_html/s/soroush_profile

# ---------- سروش‌پلاس: Bot API (مسیر جایگزین/آزمون) ----------
# فقط اگر از Bot API سروش استفاده می‌کنید پر کنید؛ مسیر اصلی UserBot است
ENABLE_SOROUSH_BOT=false
SOROUSH_BOT_TOKEN=
SOROUSH_CHAT_ID=

# ---------- مقصد ۴: آی‌گپ (UserBot با Playwright) ----------
IGAP_CHANNEL_ID=shamimeashena
IGAP_CHANNEL_NAME="شمیم آشنا"
# شناسهٔ سل کانال در لیست گفت‌وگوها: data-list-item-id
IGAP_ITEM_ID=16200343869985976
IGAP_SCRIPT=/home/file/public_html/s/send_igap.js
IGAP_PROFILE_DIR=/home/file/public_html/s/igap_profile

# ---------- پروفایل مقصدها ----------
# دکمه‌های اصلی داشبورد و صف پس‌زمینه از MAIN_* استفاده می‌کنند.
# دکمه «تست کانال‌های قبلی» از TEST_* استفاده می‌کند؛ اگر کانال تست شما فرق دارد این مقدارها را تغییر دهید.
MAIN_BALE_CHANNEL_ID=@shamimeashena
TEST_BALE_CHANNEL_ID=@testforme
MAIN_RUBIKA_CHANNEL_ID=@shamimeashena
TEST_RUBIKA_CHANNEL_ID=@shamimeashena1
MAIN_SOROUSH_CHANNEL_ID=shamimeashena
MAIN_SOROUSH_CHANNEL_NAME="شمیم آشنا"
TEST_SOROUSH_CHANNEL_ID=shamimeashena1
TEST_SOROUSH_CHANNEL_NAME="شمیم آشنا"
MAIN_IGAP_CHANNEL_ID=shamimeashena
MAIN_IGAP_CHANNEL_NAME="شمیم آشنا"
MAIN_IGAP_ITEM_ID=16200343869985976
TEST_IGAP_CHANNEL_ID=shamimeashena
TEST_IGAP_CHANNEL_NAME="شمیم آشنا"
TEST_IGAP_ITEM_ID=16200343869985976

# ---------- زمان‌بندی و تحمل خطا ----------
# کرانهٔ سخت هر اجرای UserBot (ثانیه) — دور subprocess با timeout
USERBOT_TIMEOUT_SEC=240
# زمان‌های انتظار آی‌گپ (میلی‌ثانیه)؛ کم کردن آن سرعت را بالا می‌برد اما اگر اینترنت کند است افزایش دهید
IGAP_INITIAL_WAIT_MS=3500
IGAP_VERIFY_TIMEOUT_MS=8000
# سقف تلاش برای دانلود رسانه پیش از انتشار بدون رسانه
MEDIA_MAX_RETRY=3
# فاصلهٔ بین پست‌ها در cron (ثانیه) — نرخ‌محدودسازی پلتفرم‌ها
SYNC_GAP_SEC=5
# فاصلهٔ بررسی در sync_daemon.php (ثانیه؛ مسیر legacy)
CHECK_INTERVAL_SEC=30

# ---------- صف پس‌زمینه و سرعت ----------
# باینری PHP برای worker پس‌زمینه؛ خالی = تشخیص خودکارِ «تأییدشده»
# (PHP_BINARY، ea-php8*، lsphp8*، php؛ هر کاندید با -v، اکستنشن‌ها و lint آزموده می‌شود)
# اگر دکمهٔ صف پس‌زمینه خطای PHP_CLI_NOT_FOUND داد، این‌جا مسیر کامل PHP 8 را بگذارید؛
# مثال: PHP_CLI_BIN=/opt/cpanel/ea-php83/root/usr/bin/php
# نکته: اگر خالی بماند ولی PHP_BIN (بالا) مقدار داشته باشد، از همان استفاده می‌شود.
PHP_CLI_BIN=
# سقف تعداد پست‌های جدید در هر اجرای صف پس‌زمینه (نمای وب ایتا معمولاً ~۲۰ پست نشان می‌دهد)
BACKGROUND_MAX_POSTS=50
# مکث بین پست‌ها در صف پس‌زمینه (ثانیه)؛ ۰ = بدون مکث (پیش‌فرض)
BACKGROUND_GAP_SEC=0
# ارسال هم‌زمان سروش‌پلاس و آی‌گپ (دو Chromium هم‌زمان، هر پست ~۲ برابر سریع‌تر)
# اگر سرور کم‌RAM است: 0
SYNC_PARALLEL_DISPATCH=1
# حداکثر پاس تلاش هر پلتفرم در صف پس‌زمینه برای آیتم‌های شکست‌خورده (۱ = بدون تلاش مجدد)
BACKGROUND_MAX_PASSES=2

# ---------- حالت HTTP برای cron (اختیاری) ----------
# خالی = cron_sync.sh در حالت CLI اجرا می‌شود (بدون Apache و بدون کلید)
# پر کردن آن = حالت HTTP؛ در این صورت .cron_key هم باید همان SECURITY_KEY باشد
SYNC_BASE_URL=

# ---------- مسیرهای داده ----------
STATE_DB_PATH=/home/file/public_html/s/state.sqlite
LOG_DIR=/home/file/public_html/s/logs

# ---------- اشکال‌زدایی (اختیاری) ----------
# User-Agent سفارشی برای کرومیوم؛ خالی = بدون override (توصیه‌شده)
SYNC_USER_AGENT=
# اجرای غیر headless برای ورود تعاملی روی ماشین دارای نمایشگر: 1 یا 0
SYNC_HEADED=0
# چاپ خطاهای PHP در خروجی وب/JSON فقط برای دیباگ موقت؛ در تولید 0 بماند
SYNC_DEBUG=0
